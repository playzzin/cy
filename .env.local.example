REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
# Web/PWA push notifications (Firebase Console > Cloud Messaging > Web Push certificates)
REACT_APP_FIREBASE_VAPID_KEY=
# Optional: GA4 web stream ID. Defaults to REACT_APP_FIREBASE_MEASUREMENT_ID when omitted.
# REACT_APP_GA_MEASUREMENT_ID=

# Optional: Gemini/Google AI features (ID card, bank book, reports, image generation)
REACT_APP_GOOGLE_API_KEY=
# REACT_APP_GEMINI_API_KEY=
# Server-side Gemini features such as /database/partner-photo-registration use
# /settings/ai or a Cloud Functions environment variable, not the React key above.
# GEMINI_API_KEY=

# Optional: local Todo Codex click bridge
# FIREBASE_SERVICE_ACCOUNT=./service-account.json
# REACT_APP_TODO_CODEX_BRIDGE_URL=http://127.0.0.1:8787
# TODO_CODEX_MODEL=
# TODO_CODEX_ASSIGNEE=
# TODO_CODEX_TIMEOUT_MS=1200000
# TODO_CODEX_SANDBOX=workspace-write
# TODO_CODEX_AUTO_ENABLED=false
# TODO_CODEX_AUTO_INTERVAL_MS=60000
# TODO_CODEX_BRIDGE_PORT=8787

# Optional: production observability
# REACT_APP_SENTRY_DSN=
# REACT_APP_SENTRY_TRACES_SAMPLE_RATE=0.2
# REACT_APP_SENTRY_REPLAY_SAMPLE_RATE=0.02
# REACT_APP_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1
# REACT_APP_SENTRY_TRACE_TARGETS=localhost
