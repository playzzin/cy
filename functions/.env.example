# Firebase Functions Environment Variables

# Gemini server document analysis (Firestore /settings/ai values take precedence)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DOCUMENT_MODEL=gemini-2.5-flash
GEMINI_BATCH_MODEL=gemini-2.5-flash

# SOLAPI (솔라피) 카카오톡 알림톡 설정
SOLAPI_API_KEY=your_solapi_api_key_here
SOLAPI_API_SECRET=your_solapi_api_secret_here

# 카카오톡 발신 정보
KAKAO_FROM_NUMBER=발신번호 (예: 02-1234-5678)
KAKAO_PF_ID=카카오_발신프로필ID (예: @company123)

# 템플릿 ID (솔라피에서 등록 후 발급받은 ID)
# 실제 템플릿 승인 후 .env 파일에 설정하세요
# KAKAO_TEMPLATE_TAX_INVOICE=KA01TP001
# KAKAO_TEMPLATE_PAYMENT_REQUEST=KA01TP002
# KAKAO_TEMPLATE_PAYMENT_RECEIVED=KA01TP003
# KAKAO_TEMPLATE_MONTHLY_STATEMENT=KA01TP004

# Bank SMS bridge (production secret bindings; run these before deploying the functions)
# firebase functions:secrets:set BANK_SMS_DEVICE_SECRETS
# firebase functions:secrets:set BANK_SMS_ENCRYPTION_KEY
# firebase functions:secrets:set BANK_PROVIDER_WEBHOOK_SECRETS
# Values below are local-emulator examples only. Never commit real values.
# JSON map of Android bridge device id to a random secret of at least 32 characters.
BANK_SMS_DEVICE_SECRETS={"office-phone-1":"replace-with-a-random-secret-at-least-32-characters"}
# Exact normalized sender ids accepted from the Android bridge (comma-separated).
BANK_SMS_ALLOWED_SENDERS=15889999
# Maximum accepted clock difference for signed requests, in seconds.
BANK_HMAC_MAX_SKEW_SECONDS=300
# Recipient fallback. Prefer configuring bank_notification_settings/global.recipientIds.
BANK_NOTIFICATION_RECIPIENT_IDS=
# Absolute HTTPS application origin used for push-notification click-through.
BANK_NOTIFICATION_APP_URL=https://your-app.web.app
# Required production Secret: 32-byte AES-256-GCM key (base64/hex), or JSON key ring such as
# {"v1":"<old-base64>","v2":"<active-base64>"}. Without it, raw SMS is never retained.
BANK_SMS_ENCRYPTION_KEY=
BANK_SMS_ENCRYPTION_KEY_ID=v1
# Configure Firestore TTL on bank_sms_ingestions.retentionExpiresAt and
# bank_ingestion_replay_nonces.retentionExpiresAt and
# bank_notification_outbox.retentionExpiresAt after deployment.
BANK_SMS_RETENTION_DAYS=7
# Bridge heartbeat is requested every 15 minutes; allow Android Doze delays.
BANK_BRIDGE_STALE_MINUTES=120
# Expire browser registrations that have not been refreshed by the signed-in app.
BANK_PUSH_DEVICE_MAX_AGE_DAYS=90
# Transient FCM errors retry through the Firestore outbox before dead-lettering.
BANK_PUSH_MAX_ATTEMPTS=5
# Never deliver a delayed bank alert as if it were new. This matches the 15-minute WebPush TTL.
BANK_PUSH_MAX_EVENT_AGE_MINUTES=15

# Future official-bank/provider webhook HMAC clients.
BANK_PROVIDER_WEBHOOK_SECRETS={"kb-provider":"replace-with-a-random-secret-at-least-32-characters"}
