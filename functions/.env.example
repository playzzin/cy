# Firebase Functions Environment Variables

# 바로빌 API 설정
BAROBILL_CORP_NUM=your_corp_num
BAROBILL_CERT_KEY=your_cert_key
BAROBILL_ID=your_id
BAROBILL_PWD=your_password

# SOLAPI (솔라피) 카카오톡 알림톡 설정
SOLAPI_API_KEY=your_solapi_api_key_here
SOLAPI_API_SECRET=your_solapi_api_secret_here

# 카카오톡 발신 정보
KAKAO_FROM_NUMBER=발신번호 (예: 02-1234-5678)
KAKAO_PF_ID=카카오_발신프로필ID (예: @company123)

# 템플릿 ID (솔라피에서 등록 후 발급받은 ID)
# 실제 템플릿 승인 후 .env 파일에 설정하세요
# KAKAO_TEMPLATE_TAX_INVOICE=KA01TP001
# KAKAO_TEMPLATE_PAYMENT_REQUEST=KA01TP002
# KAKAO_TEMPLATE_PAYMENT_RECEIVED=KA01TP003
# KAKAO_TEMPLATE_MONTHLY_STATEMENT=KA01TP004
