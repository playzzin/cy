{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint",
    "build": "tsc && node scripts/copy-construction-plan-assets.mjs",
    "test:bank-notifications": "npm run build && node --test lib/bankNotifications.test.js",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "node ../scripts/deploy-selected.cjs functions",
    "logs": "firebase functions:log",
    "test": "npm run build && node ../scripts/run-functions-tests.cjs"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/entry.js",
  "dependencies": {
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@napi-rs/canvas": "^0.1.80",
    "@pdf-lib/fontkit": "^1.1.1",
    "exceljs": "4.4.0",
    "firebase-admin": "^11.8.0",
    "firebase-functions": "^7.2.5",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "smart-construction": "file:..",
    "soap": "^1.0.0"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.6",
    "typescript": "^4.9.0"
  },
  "private": true
}
