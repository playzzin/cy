rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserProfile() {
      return isSignedIn() && exists(userDocPath());
    }

    function userProfile() {
      return get(userDocPath()).data;
    }

    function adminRoles() {
      return [
        'ADMIN', 'admin', 'administrator', 'super_admin', 'owner',
        'DEV', 'dev', 'Dev', 'DEVELOPER', 'developer', 'Developer',
        'SYSTEM_ADMIN', 'system_admin',
        'jhl2VTnk9V3C4EiZ4QQI', 'jhl2vtnk9v3c4eiz4qqi',
        'pos_jhl2VTnk9V3C4EiZ4QQI', 'pos_jhl2vtnk9v3c4eiz4qqi',
        '관리자', '사장', '실장', '개발', '개발자', '시스템관리자',
        '愿由ъ옄', '?ъ옣', '?ㅼ옣', '媛쒕컻', '媛쒕컻??', '?쒖뒪?쒓?由ъ옄'
      ];
    }

    function payrollRoles() {
      return [
        'PAYROLL_MANAGER', 'payroll_manager',
        '급여담당', '정산담당', '정산관리자',
        '湲됱뿬?대떦', '?뺤궛?대떦', '?뺤궛愿由ъ옄'
      ];
    }

    function financeRoles() {
      return [
        'FINANCE', 'finance', 'finance_manager',
        'ACCOUNTING', 'accounting', 'accounting_manager',
        '회계', '재무', '경리', '회계담당', '재무담당'
      ];
    }

    function officeRoles() {
      return [
        'OFFICE_STAFF', 'office_staff', 'office',
        '사무실직원', '사무직원', '사무',
        '?щТ?ㅼ쭅??', '?щТ吏곸썝'
      ];
    }

    function siteRoles() {
      return [
        'SITE_MANAGER', 'site_manager', 'MANAGER', 'manager',
        'manager1', 'manager2', 'manager3',
        'pos_manager1', 'pos_manager2', 'pos_manager3',
        'MANAGER1', 'MANAGER2', 'MANAGER3',
        '매니저', '현장관리자', '현장소장',
        '매니저1', '매니저2', '매니저3',
        '메니저1', '메니저2', '메니저3',
        '留ㅻ땲?', '?꾩옣愿由ъ옄', '?꾩옣?뚯옣'
      ];
    }

    function supportRoles() {
      return [
        'SUPPORT', 'support', 'support_manager',
        'manager1', 'pos_manager1', 'MANAGER1',
        '매니저1', '메니저1',
        '지원담당', '지원 담당', '자산관리', '자산 관리',
        '숙소관리', '숙소 관리', '차량관리', '차량 관리'
      ];
    }

    function auditRoles() {
      return [
        'AUDIT', 'audit', 'auditor', 'COMPLIANCE', 'compliance',
        '감사', '감사자', '준법'
      ];
    }

    function cardExpenseAuditRoles() {
      return [
        'CEO', 'ceo', '대표', '사장', 'pos_ceo',
        'DEV', 'dev', 'developer', '개발', '개발자'
      ];
    }

    function hasTokenRole(roles) {
      return isSignedIn()
        && (
          ('role' in request.auth.token && request.auth.token.role in roles)
          || ('position' in request.auth.token && request.auth.token.position in roles)
          || ('systemRole' in request.auth.token && request.auth.token.systemRole in roles)
          || ('accountType' in request.auth.token && request.auth.token.accountType in roles)
          || (
            'roles' in request.auth.token
            && request.auth.token.roles is list
            && request.auth.token.roles.hasAny(roles)
          )
          || (
            'additionalPositions' in request.auth.token
            && request.auth.token.additionalPositions is list
            && request.auth.token.additionalPositions.hasAny(roles)
          )
        );
    }

    function hasUserRole(roles) {
      return hasUserProfile()
        && (
          ('role' in userProfile() && userProfile().role in roles)
          || ('position' in userProfile() && userProfile().position in roles)
          || ('systemRole' in userProfile() && userProfile().systemRole in roles)
          || ('accountType' in userProfile() && userProfile().accountType in roles)
          || (
            'roles' in userProfile()
            && userProfile().roles is list
            && userProfile().roles.hasAny(roles)
          )
          || (
            'additionalPositions' in userProfile()
            && userProfile().additionalPositions is list
            && userProfile().additionalPositions.hasAny(roles)
          )
        );
    }

    function hasAnyRole(roles) {
      return hasTokenRole(roles) || hasUserRole(roles);
    }

    function isAdmin() {
      return hasAnyRole(adminRoles());
    }

    function canReadAudit() {
      return isAdmin() || hasAnyRole(auditRoles());
    }

    function canReadMasterData() {
      return isAdmin()
        || hasAnyRole(officeRoles())
        || hasAnyRole(siteRoles())
        || hasAnyRole(payrollRoles());
    }

    function canWriteMasterData() {
      return isAdmin() || hasAnyRole(officeRoles());
    }

    function hasLinkedWorker(workerId) {
      return hasUserProfile()
        && ('linkedWorkerIds' in userProfile())
        && userProfile().linkedWorkerIds is list
        && workerId in userProfile().linkedWorkerIds;
    }

    function canReadOwnWorker(workerId) {
      return isSignedIn()
        && (
          hasLinkedWorker(workerId)
          || (('uid' in resource.data) && resource.data.uid == request.auth.uid)
        );
    }

    function isValidOwnWorkerSignatureUpdate(workerId) {
      return canReadOwnWorker(workerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'signatureUrl',
          'signatureSource',
          'signatureUpdatedAt',
          'signatureConsent',
          'updatedAt'
        ])
        && request.resource.data.signatureUrl is string
        && request.resource.data.signatureSource == 'worker_direct'
        && request.resource.data.signatureConsent is map
        && request.resource.data.signatureConsent.version == 1
        && request.resource.data.signatureConsent.workerName == resource.data.name
        && request.resource.data.signatureConsent.agreedAt is string;
    }

    function canReadOperations() {
      return canReadMasterData();
    }

    // Client portal accounts are scoped to the company links managed by an
    // administrator. These helpers are deliberately read-only: a client can
    // view only the records related to its linked company and cannot mutate
    // operational or financial source data.
    function hasLinkedClientCompany(companyId) {
      return hasUserProfile()
        && ('linkedCompanyIds' in userProfile())
        && userProfile().linkedCompanyIds is list
        && companyId in userProfile().linkedCompanyIds;
    }

    function isClientPortalAccount() {
      return hasUserProfile()
        && (
          (('accountType' in userProfile()) && userProfile().accountType == 'construction_company')
          || (('role' in userProfile()) && userProfile().role in ['발주사', '건설사', '원청', 'client', 'client_company', 'construction_company'])
          || (('position' in userProfile()) && userProfile().position in ['발주사', '건설사', '원청', 'client', 'client_company', 'construction_company'])
        );
    }

    function canReadClientCompany(companyId) {
      return isClientPortalAccount() && hasLinkedClientCompany(companyId);
    }

    function canReadClientSite() {
      return isClientPortalAccount()
        && ('clientCompanyId' in resource.data)
        && hasLinkedClientCompany(resource.data.clientCompanyId);
    }

    function canReadClientDailyReport() {
      return isClientPortalAccount()
        && ('companyId' in resource.data)
        && hasLinkedClientCompany(resource.data.companyId);
    }

    function canReadClientProgressClaim() {
      return isClientPortalAccount()
        && ('siteId' in resource.data)
        && resource.data.siteId is string
        && exists(/databases/$(database)/documents/sites/$(resource.data.siteId))
        && ('clientCompanyId' in get(/databases/$(database)/documents/sites/$(resource.data.siteId)).data)
        && hasLinkedClientCompany(
          get(/databases/$(database)/documents/sites/$(resource.data.siteId)).data.clientCompanyId
        );
    }

    function hasLinkedRentalCompany(companyId) {
      return hasUserProfile()
        && ('linkedCompanyIds' in userProfile())
        && userProfile().linkedCompanyIds is list
        && companyId in userProfile().linkedCompanyIds;
    }

    function isRentalPortalAccount() {
      return hasUserProfile()
        && (
          (('accountType' in userProfile()) && userProfile().accountType == 'rental_company')
          || (('role' in userProfile()) && userProfile().role in ['임대사', 'rental', 'rental_company'])
          || (('position' in userProfile()) && userProfile().position in ['임대사', 'rental', 'rental_company'])
        );
    }

    function canReadRentalCompany(companyId) {
      return isRentalPortalAccount() && hasLinkedRentalCompany(companyId);
    }

    function canReadClientMaterialTransaction() {
      return isClientPortalAccount()
        && ('siteId' in resource.data)
        && resource.data.siteId is string
        && exists(/databases/$(database)/documents/sites/$(resource.data.siteId))
        && ('clientCompanyId' in get(/databases/$(database)/documents/sites/$(resource.data.siteId)).data)
        && hasLinkedClientCompany(
          get(/databases/$(database)/documents/sites/$(resource.data.siteId)).data.clientCompanyId
        );
    }

    function canReadRentalMaterialTransaction() {
      return isRentalPortalAccount()
        && ('rentalCompanyId' in resource.data)
        && resource.data.rentalCompanyId is string
        && hasLinkedRentalCompany(resource.data.rentalCompanyId);
    }

    function canReadClientMaterialPhotoBatch() {
      return isClientPortalAccount()
        && ('siteId' in resource.data)
        && resource.data.siteId is string
        && exists(/databases/$(database)/documents/sites/$(resource.data.siteId))
        && ('clientCompanyId' in get(/databases/$(database)/documents/sites/$(resource.data.siteId)).data)
        && hasLinkedClientCompany(
          get(/databases/$(database)/documents/sites/$(resource.data.siteId)).data.clientCompanyId
        );
    }

    function canReadRentalMaterialPhotoBatch() {
      return isRentalPortalAccount()
        && ('rentalCompanyId' in resource.data)
        && resource.data.rentalCompanyId is string
        && hasLinkedRentalCompany(resource.data.rentalCompanyId);
    }

    function canWriteOperations() {
      return isAdmin() || hasAnyRole(officeRoles()) || hasAnyRole(siteRoles());
    }

    function constructionPlanCentralRoles() {
      // Access claims are normalized by syncUserAccessClaims. Keep this list
      // compact because the plan rules share the 1,000-expression budget with
      // the repository's generic collection guards.
      return [
        'ADMIN', 'admin', 'administrator', 'super_admin', 'owner',
        'DEV', 'Dev', 'dev', 'DEVELOPER', 'Developer', 'developer',
        'SYSTEM_ADMIN', 'system_admin',
        'jhl2VTnk9V3C4EiZ4QQI', 'jhl2vtnk9v3c4eiz4qqi',
        'pos_jhl2VTnk9V3C4EiZ4QQI', 'pos_jhl2vtnk9v3c4eiz4qqi',
        '관리자', '사장', '실장', '개발', '개발자', '시스템관리자',
        'OFFICE_STAFF', 'office_staff', 'office',
        '사무실직원', '사무직원', '사무'
      ];
    }

    function hasConstructionPlanCentralAccess() {
      let roles = constructionPlanCentralRoles();
      return isSignedIn()
        && (
          request.auth.token.get('role', '') in roles
          || request.auth.token.get('position', '') in roles
          || request.auth.token.get('systemRole', '') in roles
          || request.auth.token.get('accountType', '') in roles
          || (
            request.auth.token.get('roles', []) is list
            && request.auth.token.get('roles', []).hasAny(roles)
          )
          || (
            request.auth.token.get('additionalPositions', []) is list
            && request.auth.token.get('additionalPositions', []).hasAny(roles)
          )
          || (
            hasUserProfile()
            && (
              userProfile().get('role', '') in roles
              || userProfile().get('position', '') in roles
              || userProfile().get('systemRole', '') in roles
              || userProfile().get('accountType', '') in roles
              || (
                userProfile().get('roles', []) is list
                && userProfile().get('roles', []).hasAny(roles)
              )
              || (
                userProfile().get('additionalPositions', []) is list
                && userProfile().get('additionalPositions', []).hasAny(roles)
              )
            )
          )
        );
    }

    function isConstructionPlanParticipant(data) {
      let participants = data.get('participants', {});
      return isSignedIn()
        && (
          data.get('createdBy', '') == request.auth.uid
          || (
            participants is map
            && (
              (
                participants.get('authorIds', []) is list
                && request.auth.uid in participants.get('authorIds', [])
              )
              || (
                participants.get('reviewerIds', []) is list
                && request.auth.uid in participants.get('reviewerIds', [])
              )
              || (
                participants.get('approverIds', []) is list
                && request.auth.uid in participants.get('approverIds', [])
              )
            )
          )
        );
    }

    function canReadConstructionPlanData(data) {
      // Participants are server-assigned and provide the canonical browser
      // boundary even when the legacy user profile only stores worker links.
      // Central staff retain portfolio-wide read access.
      return hasConstructionPlanCentralAccess()
        || isConstructionPlanParticipant(data);
    }

    function isConstructionPlanAuthor(data) {
      let participants = data.get('participants', {});
      return isSignedIn()
        && (
          data.get('createdBy', '') == request.auth.uid
          || (
            participants is map
            && participants.get('authorIds', []) is list
            && request.auth.uid in participants.get('authorIds', [])
          )
        );
    }

    function canWriteConstructionPlanData(data) {
      // Authorship is server-assigned and immutable to browser updates. It is
      // therefore the canonical edit boundary even for legacy accounts whose
      // user profile only links a worker id and has no denormalized siteId.
      return isConstructionPlanAuthor(data)
        || hasConstructionPlanCentralAccess();
    }

    function canReadConstructionPlanById(planId) {
      let planPath = /databases/$(database)/documents/constructionPlans/$(planId);
      return exists(planPath) && canReadConstructionPlanData(get(planPath).data);
    }

    function canReadFinance() {
      return isAdmin() || hasAnyRole(payrollRoles()) || hasAnyRole(financeRoles());
    }

    function canWriteFinance() {
      return canReadFinance();
    }

    // Monthly payroll becomes immutable once it has been reviewed. The UI
    // writes a complete draft snapshot first, then performs status-only
    // transitions. This keeps a confirmed or paid payroll from being silently
    // overwritten by a later recalculation of its source data.
    function payrollSettlementStatus(data) {
      return ('runStatus' in data && data.runStatus in ['reviewed', 'confirmed', 'paid'])
        ? data.runStatus
        : 'draft';
    }

    function isPayrollSettlementStatusOnlyUpdate(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    function isValidPayrollSettlementCreate() {
      return canWriteFinance()
        && (!('runStatus' in request.resource.data) || request.resource.data.runStatus == 'draft');
    }

    function isValidPayrollSettlementUpdate() {
      let beforeStatus = payrollSettlementStatus(resource.data);
      let afterStatus = payrollSettlementStatus(request.resource.data);
      return canWriteFinance()
        && (
          (beforeStatus == 'draft' && afterStatus == 'draft')
          || (
            beforeStatus == 'draft'
            && afterStatus == 'reviewed'
            && isPayrollSettlementStatusOnlyUpdate([
              'runStatus', 'reviewedAt', 'reviewedByUid', 'reviewedByName',
              'updatedAt', 'updatedByUid', 'updatedByName'
            ])
          )
          || (
            beforeStatus == 'draft'
            && afterStatus == 'confirmed'
            && isPayrollSettlementStatusOnlyUpdate([
              'runStatus', 'confirmedAt', 'confirmedByUid', 'confirmedByName',
              'updatedAt', 'updatedByUid', 'updatedByName'
            ])
          )
          || (
            beforeStatus == 'reviewed'
            && afterStatus == 'confirmed'
            && isPayrollSettlementStatusOnlyUpdate([
              'runStatus', 'confirmedAt', 'confirmedByUid', 'confirmedByName',
              'updatedAt', 'updatedByUid', 'updatedByName'
            ])
          )
          || (
            beforeStatus == 'confirmed'
            && afterStatus == 'paid'
            && isPayrollSettlementStatusOnlyUpdate([
              'runStatus', 'paidAt', 'paidByUid', 'paidByName',
              'updatedAt', 'updatedByUid', 'updatedByName'
            ])
          )
        );
    }

    function canReadSupport() {
      return isAdmin()
        || hasAnyRole(officeRoles())
        || hasAnyRole(supportRoles())
        || hasAnyRole(payrollRoles());
    }

    function canWriteSupport() {
      return isAdmin() || hasAnyRole(officeRoles()) || hasAnyRole(supportRoles());
    }

    function canReadCardBillingStatements() {
      return isAdmin()
        || hasAnyRole(officeRoles())
        || hasAnyRole(supportRoles())
        || hasAnyRole(financeRoles())
        || hasAnyRole(payrollRoles());
    }

    function canAccessCardExpenseAudit() {
      return hasAnyRole(cardExpenseAuditRoles());
    }

    function canRecruitingRead() {
      return canReadOperations();
    }

    function canRecruitingRegister() {
      return isAdmin() || hasAnyRole(officeRoles()) || hasAnyRole(payrollRoles());
    }

    function canRecruitingSettle() {
      return isAdmin() || hasAnyRole(payrollRoles());
    }

    function isMasterDataCollection(collectionId) {
      return collectionId in [
        'companies',
        'teams',
        'workers',
        'office_staff',
        'sites',
        'account_links',
        'account_directory_entries'
      ];
    }

    function isOperationsCollection(collectionId) {
      return collectionId in [
        'daily_reports',
        'daily_report_workers',
        'daily_worker_report_sites',
        'daily_dispatches',
        'field_schedule_requests',
        'schedule_confirmation_boards',
        'tasks',
        'task_requests'
      ];
    }

    function isMaterialCollection(collectionId) {
      return collectionId in [
        'materials',
        'materialInbounds',
        'materialOutbounds',
        'materialPhotoBatches'
      ];
    }

    function isRecruitingCollection(collectionId) {
      return collectionId in [
        'recruiting_referrers',
        'service_worker_referrals',
        'service_referral_daily_lines',
        'service_referral_monthly_settlements',
        'service_referral_settings',
        'service_worker_history',
        'service_referral_payments',
        'service_referral_deposits',
        'service_referral_receivables'
      ];
    }

    function isFinanceCollection(collectionId) {
      return collectionId in [
        'advance_payments',
        'advance_requests',
        'monthly_payroll_settlements',
        'payments',
        'tax_invoices',
        'receivables',
        'receivable_ledgers',
        'receivable_payments',
        'contracts',
        'progress_claims',
        'client_site_labor_adjustments',
        'settlements',
        'settlement_targets',
        'buyback_workbook_entries',
        'team_settlement_documents',
        'daily_advance_workbook_profiles',
        'daily_advance_statement_recruiter_fees',
        'workbook_ledger_logs',
        'tax_ledger_entries',
        'quarter_vat_payments',
        'quarter_vat_payments_dawon',
        'freelancers',
        'freelancerPayments'
      ];
    }

    function isSupportCollection(collectionId) {
      return collectionId in [
        'vehicles',
        'vehicleAssignments',
        'vehicle_assignments',
        'vehicleExpenses',
        'vehicle_expenses',
        'vehicle_billing_targets',
        'vehicle_billing_documents',
        'vehicle_billing_logs',
        'cardTransactions',
        'cardBillings',
        'card_billing_logs',
        'accommodations',
        'accommodationAssignments',
        'accommodationUtilityRecords',
        'accommodation_billing_targets',
        'accommodation_billing_documents',
        'accommodation_billing_line_items',
        'accommodation_billing_logs',
        'support_cancellation_logs',
        'support_write_operations',
        'support_shared_data',
        'support_client_site_allocations',
        'team_expense_claims',
        'team_expense_ledgers',
        'team_expense_categories'
      ];
    }

    function isAdminCollection(collectionId) {
      return collectionId in [
        'settings',
        'server_settings',
        'system_configs',
        'system_logs',
        'menu_configs',
        'menus',
        'positions',
        'components',
        'users',
        'app_users',
        'login_logs',
        'audit_logs',
        'database_logs',
        'daily_report_logs',
        'material_logs',
        'settlement_alert_states',
        'welfare_admin_permissions',
        'welfare_audit_logs'
      ];
    }

    function isIncidentCaseCollection(collectionId) {
      return collectionId in [
        'incident_cases',
        'incident_case_categories'
      ];
    }

    function isDateOnlyOrNull(value) {
      return value == null
        || (value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}$'));
    }

    function hasValidIncidentCaseShape(data) {
      return data.keys().hasAll([
          'caseNumber',
          'personName',
          'birthDate',
          'title',
          'caseType',
          'categoryId',
          'incidentDate',
          'record',
          'createdByUid',
          'updatedByUid',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'caseNumber',
          'personName',
          'birthDate',
          'title',
          'caseType',
          'categoryId',
          'incidentDate',
          'record',
          'createdByUid',
          'updatedByUid',
          'createdAt',
          'updatedAt'
        ])
        && data.caseNumber is string && data.caseNumber.size() <= 32
        && data.personName is string && data.personName.size() > 0 && data.personName.size() <= 40
        && data.birthDate is string && data.birthDate.size() > 0 && data.birthDate.size() <= 20
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.caseType in ['incident', 'accident']
        && data.categoryId is string && data.categoryId.size() <= 80
        && isDateOnlyOrNull(data.incidentDate)
        && data.record is string && data.record.size() > 0 && data.record.size() <= 3000
        && data.createdByUid is string && data.createdByUid.size() <= 128
        && data.updatedByUid is string && data.updatedByUid.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasValidIncidentCategoryShape(data) {
      return data.keys().hasAll(['name', 'color', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'color', 'active', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.color is string && data.color.matches('^#[0-9a-fA-F]{6}$')
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isCardStatementImportCollection(collectionId) {
      return collectionId in [
        'cardStatementImportJobs',
        'cardStatementImportFiles',
        'cardStatementImportResults',
        'cardStatementImportSourceClaims'
      ];
    }

    function isWelfareCollection(collectionId) {
      return collectionId in [
        'welfare_ledger_transactions',
        'welfare_account_snapshots',
        'welfare_categories',
        'welfare_game_daily_usage',
        'welfare_game_plays'
      ];
    }

    function isBankNotificationCollection(collectionId) {
      return collectionId in [
        'bank_sms_ingestions',
        'bank_transaction_candidates',
        'bank_notification_settings',
        'notification_devices',
        'bank_notification_health',
        'bank_notification_outbox',
        'bank_ingestion_replay_nonces',
        'bank_provider_events'
      ];
    }

    function isCardExpenseAuditCollection(collectionId) {
      return collectionId in [
        'cardExpenseAuditPolicies',
        'cardExpenseAuditRuns',
        'cardExpenseAuditFindings',
        'cardExpenseAuditReviewLogs'
      ];
    }

    function isLockedCollection(collectionId) {
      // High-volume construction-plan writes also reach the generic fallback
      // match. Short-circuit these server-controlled collections before the
      // large ERP collection classifiers to stay under the rules expression
      // budget.
      return collectionId in [
          'constructionPlans',
          'constructionPlanSeries',
          'constructionPlanMutationKeys',
          'constructionPlanTemplates',
          'constructionPlanExportJobs',
          'constructionPlanPdfRenderOperations',
          'constructionPlanUploadSessions',
          'constructionPlanDrawingReuseJobs',
          'constructionPlanLockRequests',
          'constructionPlanLifecycleMutationReceipts',
          'constructionPlanPdfDownloadReceipts',
          'constructionPlanPdfDownloadGrants',
          'constructionPlanRecordUploadSessions',
          'constructionPlanRecordExports',
          'constructionPlanAuditEvents',
          'constructionPlanRecords'
        ]
        || isMasterDataCollection(collectionId)
        || isOperationsCollection(collectionId)
        || isMaterialCollection(collectionId)
        || isRecruitingCollection(collectionId)
        || isFinanceCollection(collectionId)
        || isCardStatementImportCollection(collectionId)
        || isSupportCollection(collectionId)
        || isAdminCollection(collectionId)
        || isIncidentCaseCollection(collectionId)
        || isWelfareCollection(collectionId)
        || isBankNotificationCollection(collectionId)
        || isCardExpenseAuditCollection(collectionId)
        || collectionId in ['cards', 'cardAssignments', 'cardBillingTargets']
        || collectionId == 'vehicleExpenseImportIdentities'
        || collectionId == 'erp_messages';
    }

    function isConstructionPlanEditableStatus(status) {
      return status in ['draft', 'changes_requested'];
    }

    function isValidConstructionPlanTransition(beforeStatus, afterStatus) {
      return (beforeStatus == 'draft' && afterStatus in ['in_review', 'void', 'archived'])
        || (beforeStatus == 'in_review' && afterStatus in ['changes_requested', 'review_completed', 'draft', 'void'])
        || (beforeStatus == 'changes_requested' && afterStatus in ['in_review', 'void', 'archived'])
        || (beforeStatus == 'review_completed' && afterStatus in ['approved_pending_issue', 'changes_requested', 'void'])
        || (beforeStatus == 'approved_pending_issue' && afterStatus in ['issued', 'void'])
        || (beforeStatus == 'issued' && afterStatus in ['superseded', 'archived'])
        || (beforeStatus == 'superseded' && afterStatus == 'archived')
        || (beforeStatus == 'void' && afterStatus == 'archived');
    }

    function isClientConstructionPlanTransition(beforeStatus, afterStatus) {
      // Every workflow transition is server-owned. Browser clients may save
      // editable content while holding a lock, but cannot forge review,
      // approval, snapshot or issued-for-use control fields.
      return false;
    }

    function isConstructionPlanControlOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'updatedBy',
        'updatedAt',
        'lockVersion',
        'editLock',
        'activeReviewSnapshotId',
        'approvedSnapshotId',
        'issuedExportId',
        'releaseReadiness',
        'validationSummary'
      ]);
    }

    function isConstructionPlanLockOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'updatedBy',
        'updatedAt',
        'lockVersion',
        'editLock'
      ]);
    }

    function isConstructionPlanStatusTransitionUpdate(beforeStatus) {
      return beforeStatus in ['issued', 'superseded']
        ? request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'updatedBy', 'updatedAt', 'lockVersion', 'editLock'
          ])
        : isConstructionPlanControlOnlyUpdate();
    }

    function isConstructionPlanEditableUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      // Keep the overwhelmingly common autosave branch minimal: this ruleset
      // is large enough that evaluating nested snapshot checks unnecessarily
      // can exceed Firestore's 1,000-expression request budget.
      return changed.hasAny(['projectSnapshot'])
        ? (
          !changed.hasAny(['organizationSnapshot'])
          && changed.hasOnly([
            'title', 'documentDate', 'projectSnapshot', 'sections', 'sectionOrder', 'drawings',
            'drawingApplicability', 'engineeringValues', 'equipmentPlan',
            'riskAssessments', 'status', 'updatedBy', 'updatedAt', 'lockVersion', 'editLock'
          ])
          && ('projectSnapshot' in resource.data)
          && ('projectSnapshot' in request.resource.data)
          && request.resource.data.projectSnapshot.diff(resource.data.projectSnapshot)
            .affectedKeys().hasOnly([
              'buildings', 'floors', 'zones', 'emergencyContactsComplete'
            ])
        )
        : changed.hasAny(['organizationSnapshot'])
          ? (
            changed.hasOnly([
              'title', 'documentDate', 'organizationSnapshot', 'sections', 'sectionOrder', 'drawings',
              'drawingApplicability', 'engineeringValues', 'equipmentPlan',
              'riskAssessments', 'status', 'updatedBy', 'updatedAt', 'lockVersion', 'editLock'
            ])
            && request.resource.data.get('organizationSnapshot', {}).get('sourceSiteId', null)
              == resource.data.get('organizationSnapshot', {}).get('sourceSiteId', null)
            && request.resource.data.get('organizationSnapshot', {}).get('workerDirectoryProvenance', null)
              == resource.data.get('organizationSnapshot', {}).get('workerDirectoryProvenance', null)
          )
          : changed.hasOnly([
            'title', 'documentDate', 'sections', 'sectionOrder', 'drawings',
            'drawingApplicability', 'engineeringValues', 'equipmentPlan',
            'riskAssessments', 'status', 'updatedBy', 'updatedAt', 'lockVersion', 'editLock'
          ]);
    }

    function ownsConstructionPlanLock() {
      return ('editLock' in resource.data)
        && resource.data.editLock.userId == request.auth.uid
        && resource.data.editLock.expiresAtEpochMs is number
        && resource.data.editLock.expiresAtEpochMs > request.time.toMillis();
    }

    function hasValidRequestedConstructionPlanLock() {
      return ('editLock' in request.resource.data)
        && request.resource.data.editLock.userId == request.auth.uid
        && request.resource.data.editLock.userName is string
        && request.resource.data.editLock.acquiredAt is string
        && request.resource.data.editLock.heartbeatAt is string
        && request.resource.data.editLock.expiresAt is string
        && request.resource.data.editLock.expiresAtEpochMs is number
        && request.resource.data.editLock.expiresAtEpochMs > request.time.toMillis()
        && request.resource.data.editLock.expiresAtEpochMs <= request.time.toMillis() + 300000;
    }

    function isValidConstructionPlanLockMutation(beforeStatus) {
      let hadLock = 'editLock' in resource.data;
      let hasLock = 'editLock' in request.resource.data;
      let priorLockExpired = hadLock
        && resource.data.editLock.expiresAtEpochMs is number
        && resource.data.editLock.expiresAtEpochMs <= request.time.toMillis();
      let priorLockOwned = hadLock && resource.data.editLock.userId == request.auth.uid;
      return request.resource.data.lockVersion == resource.data.lockVersion + 1
        && (
          (
            hasLock
            && isConstructionPlanEditableStatus(beforeStatus)
            && hasValidRequestedConstructionPlanLock()
            && (!hadLock || priorLockOwned || priorLockExpired)
            && (
              !hadLock
              || priorLockExpired
              || request.resource.data.editLock.acquiredAt == resource.data.editLock.acquiredAt
            )
          )
          || (
            !hasLock
            && hadLock
            && priorLockOwned
          )
        );
    }

    function canApproveConstructionPlan() {
      return isAdmin() || hasAnyRole(officeRoles());
    }

    function isValidConstructionPlanUpdate() {
      let beforeStatus = resource.data.status;
      let afterStatus = request.resource.data.status;
      let statusChanged = beforeStatus != afterStatus;
      let approvalTransition = afterStatus in ['approved_pending_issue', 'issued', 'superseded'];
      return request.resource.data.updatedBy == request.auth.uid
        // Approval snapshots and issued-for-use exports are produced by the
        // trusted server pipeline. Admin SDK writes bypass these client rules.
        && !approvalTransition
        && (
          (
            !statusChanged
            && isConstructionPlanEditableStatus(beforeStatus)
            && isConstructionPlanEditableUpdate()
            && ownsConstructionPlanLock()
            && request.resource.data.lockVersion == resource.data.lockVersion + 1
            && request.resource.data.editLock == resource.data.editLock
          )
          || (
            !statusChanged
            && isConstructionPlanLockOnlyUpdate()
            && isValidConstructionPlanLockMutation(beforeStatus)
          )
          || (
            statusChanged
            && isValidConstructionPlanTransition(beforeStatus, afterStatus)
            && isClientConstructionPlanTransition(beforeStatus, afterStatus)
            && isConstructionPlanStatusTransitionUpdate(beforeStatus)
            && ownsConstructionPlanLock()
            && request.resource.data.lockVersion == resource.data.lockVersion + 1
            && request.resource.data.editLock == resource.data.editLock
            && (!approvalTransition || canApproveConstructionPlan())
          )
        );
    }

    function isNullableString(value) {
      return value == null || value is string;
    }

    function isCardLifecycleParentTouched(cardId) {
      return cardId is string
        && exists(/databases/$(database)/documents/cards/$(cardId))
        && getAfter(/databases/$(database)/documents/cards/$(cardId)).data.get('updatedAt', null)
          != get(/databases/$(database)/documents/cards/$(cardId)).data.get('updatedAt', null);
    }

    function isCardLifecycleParentActiveAfter(cardId) {
      return cardId is string
        && existsAfter(/databases/$(database)/documents/cards/$(cardId))
        && getAfter(/databases/$(database)/documents/cards/$(cardId)).data.status in ['AVAILABLE', 'ASSIGNED'];
    }

    function isCardLifecycleParentMissing(cardId) {
      return cardId is string
        && !exists(/databases/$(database)/documents/cards/$(cardId));
    }

    function isOpenCardLink(data) {
      return !(data.get('endDate', null) is string
        && data.get('endDate', null).matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function hasCardLifecycleLog(operationId, cardId, statusAfter) {
      return operationId is string
        && existsAfter(/databases/$(database)/documents/support_cancellation_logs/$(operationId))
        && getAfter(/databases/$(database)/documents/support_cancellation_logs/$(operationId)).data.resourceType == 'card'
        && getAfter(/databases/$(database)/documents/support_cancellation_logs/$(operationId)).data.resourceId == cardId
        && getAfter(/databases/$(database)/documents/support_cancellation_logs/$(operationId)).data.statusAfter == statusAfter
        && getAfter(/databases/$(database)/documents/support_cancellation_logs/$(operationId)).data.createdAt == request.time;
    }

    function hasEmptyCardOperationalSnapshot(data) {
      return data.get('currentAssigneeId', null) == null
        && data.get('currentAssigneeType', null) == null
        && data.get('currentAssigneeName', null) == null
        && data.get('billingTargetId', null) == null
        && data.get('billingTargetType', null) == null
        && data.get('billingTargetName', null) == null
        && data.get('billingTargetStartDate', null) == null
        && data.get('billingTargetEndDate', null) == null;
    }

    function hasUnchangedCardLifecycleMetadata() {
      return request.resource.data.get('lastLifecycleOperationId', null)
          == resource.data.get('lastLifecycleOperationId', null)
        && request.resource.data.get('lastLifecycleOperationType', null)
          == resource.data.get('lastLifecycleOperationType', null)
        && request.resource.data.get('lastLifecycleOperationAt', null)
          == resource.data.get('lastLifecycleOperationAt', null);
    }

    function hasValidCardLifecycleMarker(operationId, operationType, cardId, statusAfter) {
      return request.resource.data.get('lastLifecycleOperationType', null) == operationType
        && request.resource.data.get('lastLifecycleOperationAt', null) == request.time
        && operationId != resource.data.get('lastLifecycleOperationId', null)
        && hasCardLifecycleLog(operationId, cardId, statusAfter);
    }

    function isValidCardStatusUpdate(cardId) {
      let beforeStatus = resource.data.status;
      let afterStatus = request.resource.data.status;
      let operationId = request.resource.data.get('lastLifecycleOperationId', null);
      return request.resource.data.get('updatedAt', null) == request.time
        && (
        (
          beforeStatus == afterStatus
          && afterStatus in ['AVAILABLE', 'ASSIGNED']
          && hasUnchangedCardLifecycleMetadata()
        )
        || (
          beforeStatus == afterStatus
          && afterStatus in ['SUSPENDED', 'CLOSED']
          && hasEmptyCardOperationalSnapshot(request.resource.data)
          && (
            hasUnchangedCardLifecycleMetadata()
            || hasValidCardLifecycleMarker(operationId, 'CANCEL', cardId, afterStatus)
          )
        )
        || (
          beforeStatus in ['AVAILABLE', 'ASSIGNED']
          && afterStatus in ['AVAILABLE', 'ASSIGNED']
          && hasUnchangedCardLifecycleMetadata()
        )
        || (
          beforeStatus in ['AVAILABLE', 'ASSIGNED']
          && afterStatus in ['SUSPENDED', 'CLOSED']
          && hasEmptyCardOperationalSnapshot(request.resource.data)
          && hasValidCardLifecycleMarker(operationId, 'CANCEL', cardId, afterStatus)
        )
        || (
          beforeStatus == 'SUSPENDED'
          && afterStatus == 'AVAILABLE'
          && hasEmptyCardOperationalSnapshot(request.resource.data)
          && hasValidCardLifecycleMarker(operationId, 'RESTORE', cardId, afterStatus)
        )
      );
    }

    function isVerifiedRequestDisplayName(value) {
      return value is string
        && (
          value == request.auth.uid
          || (request.auth.token.email is string && value == request.auth.token.email)
        );
    }

    function isValidBankCandidateReviewUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'reviewedBy',
          'reviewedAt',
          'updatedAt'
        ])
        && (
          (resource.data.status == 'pending'
            && request.resource.data.status in ['confirmed', 'ignored'])
          || (resource.data.status == 'parse_failed'
            && request.resource.data.status == 'ignored')
        )
        && request.resource.data.reviewedBy is map
        && request.resource.data.reviewedBy.keys().hasAll(['uid', 'displayName'])
        && request.resource.data.reviewedBy.keys().hasOnly(['uid', 'displayName', 'email'])
        && request.resource.data.reviewedBy.uid == request.auth.uid
        && isVerifiedRequestDisplayName(request.resource.data.reviewedBy.displayName)
        && request.resource.data.reviewedBy.email == request.auth.token.email
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidBankNotificationSettings(data) {
      return data.keys().hasAll([
          'enabled',
          'recipientIds',
          'minimumAmount',
          'directions',
          'notifyOnParseFailure',
          'quietHours',
          'updatedById',
          'updatedByName',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'enabled',
          'recipientIds',
          'minimumAmount',
          'directions',
          'notifyOnParseFailure',
          'quietHours',
          'updatedById',
          'updatedByName',
          'updatedAt'
        ])
        && data.enabled is bool
        && data.recipientIds is list
        && data.recipientIds.size() <= 100
        && data.minimumAmount is number
        && data.minimumAmount >= 0
        && data.directions is list
        && data.directions.size() > 0
        && data.directions.size() <= 2
        && data.directions.hasOnly(['deposit', 'withdrawal'])
        && data.notifyOnParseFailure is bool
        && data.quietHours is map
        && data.quietHours.keys().hasAll(['enabled', 'start', 'end', 'timezone'])
        && data.quietHours.keys().hasOnly(['enabled', 'start', 'end', 'timezone'])
        && data.quietHours.enabled is bool
        && data.quietHours.start is string
        && data.quietHours.start.matches('^([01]\\d|2[0-3]):[0-5]\\d$')
        && data.quietHours.end is string
        && data.quietHours.end.matches('^([01]\\d|2[0-3]):[0-5]\\d$')
        && data.quietHours.timezone == 'Asia/Seoul'
        && data.updatedById == request.auth.uid
        && isVerifiedRequestDisplayName(data.updatedByName)
        && data.updatedAt == request.time;
    }

    function isValidOwnNotificationDevice(data) {
      return data.keys().hasAll(['uid', 'token', 'platform', 'permission', 'enabled', 'updatedAt'])
        && data.keys().hasOnly([
          'uid',
          'token',
          'platform',
          'label',
          'browser',
          'userAgent',
          'permission',
          'enabled',
          'disabledReason',
          'createdAt',
          'updatedAt',
          'lastSeenAt'
        ])
        && data.uid == request.auth.uid
        && data.token is string
        && data.token.size() >= 20
        && data.token.size() <= 4096
        && data.platform == 'web'
        && data.permission in ['default', 'denied', 'granted', 'unsupported']
        && data.enabled is bool
        && (!('disabledReason' in data) || data.disabledReason in ['invalid-token'])
        && (!('label' in data) || (data.label is string && data.label.size() <= 100))
        && (!('browser' in data) || (data.browser is string && data.browser.size() <= 100))
        && (!('userAgent' in data) || (data.userAgent is string && data.userAgent.size() <= 1024))
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && data.updatedAt is timestamp
        && (!('lastSeenAt' in data) || data.lastSeenAt is timestamp);
    }

    function isBankSystemMessage(data) {
      return data is map
        && (
          ('senderId' in data && data.senderId == 'system:bank-notification')
          || 'bankCandidateId' in data
        );
    }

    function canReadBankSystemMessage(data) {
      return isAdmin()
        || ('recipientIds' in data && data.recipientIds is list && request.auth.uid in data.recipientIds);
    }

    function canReadRegularErpMessage(data) {
      return isAdmin()
        || ('senderId' in data && data.senderId == request.auth.uid)
        || ('recipientScope' in data && data.recipientScope == 'all')
        || ('recipientIds' in data && data.recipientIds is list && request.auth.uid in data.recipientIds);
    }

    function isValidErpMessageReadReceiptUpdate() {
      return resource.data.recipientIds is list
        && request.auth.uid in resource.data.recipientIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'readBy',
          'readAtBy',
          'updatedAt'
        ])
        && resource.data.readBy is list
        && request.resource.data.readBy is list
        && !(request.auth.uid in resource.data.readBy)
        && request.resource.data.readBy.hasAll(resource.data.readBy)
        && request.resource.data.readBy.hasOnly(resource.data.readBy.concat([request.auth.uid]))
        && request.resource.data.readBy.size() == resource.data.readBy.size() + 1
        && request.auth.uid in request.resource.data.readBy
        && resource.data.readAtBy is map
        && request.resource.data.readAtBy is map
        && request.resource.data.readAtBy.diff(resource.data.readAtBy).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.readAtBy[request.auth.uid] == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isSafeSelfUserCreate(userId) {
      return isSelf(userId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'lastLogin',
          'role',
          'linkedWorkerIds',
          'linkedCompanyIds',
          'linkedOfficeStaffIds',
          'status',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'pending'
        && isNullableString(request.resource.data.email)
        && isNullableString(request.resource.data.displayName)
        && isNullableString(request.resource.data.photoURL)
        && request.resource.data.linkedWorkerIds is list
        && request.resource.data.linkedWorkerIds.size() == 0
        && request.resource.data.linkedCompanyIds is list
        && request.resource.data.linkedCompanyIds.size() == 0
        && request.resource.data.linkedOfficeStaffIds is list
        && request.resource.data.linkedOfficeStaffIds.size() == 0;
    }

    function isSafeSelfUserUpdate(userId) {
      return isSelf(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email',
          'displayName',
          'photoURL',
          'lastLogin',
          'phoneNumber',
          'department',
          'updatedAt'
        ]);
    }

    function canWriteSettingsDocument(settingsId) {
      return !settingsId.matches('^menus_v[0-9]+$')
        || settingsId == 'menus_v12';
    }

    function isLoginFailureLogCreate() {
      return request.auth == null
        && request.resource.data.keys().hasOnly([
          'id',
          'action',
          'actionLabel',
          'status',
          'provider',
          'method',
          'actor',
          'email',
          'summaryLines',
          'summaryText',
          'errorCode',
          'errorMessage',
          'client',
          'createdAt',
          'createdAtIso'
        ])
        && request.resource.data.action == 'login_failed'
        && request.resource.data.status == 'failed'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.actor is map
        && request.resource.data.client is map
        && request.resource.data.summaryLines is list
        && request.resource.data.summaryLines.size() <= 8
        && request.resource.data.summaryText is string
        && request.resource.data.summaryText.size() <= 2000
        && (request.resource.data.email == null || request.resource.data.email is string)
        && (request.resource.data.errorCode == null || request.resource.data.errorCode is string)
        && (request.resource.data.errorMessage == null || request.resource.data.errorMessage is string)
        && request.resource.data.actor.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL'])
        && request.resource.data.client.keys().hasOnly([
          'userAgent',
          'browser',
          'os',
          'platform',
          'language',
          'timezone',
          'path',
          'referrer',
          'screen',
          'viewport'
        ]);
    }

    match /users/{userId} {
      allow get: if isAdmin() || isSelf(userId);
      allow list: if isAdmin();
      allow create: if isAdmin() || isSafeSelfUserCreate(userId);
      allow update: if isAdmin() || isSafeSelfUserUpdate(userId);
      allow delete: if isAdmin();
    }

    match /login_logs/{logId} {
      allow create: if isSignedIn() || isLoginFailureLogCreate();
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    match /settings/{settingsId} {
      allow read: if isSignedIn();
      allow create, update: if (isAdmin() && canWriteSettingsDocument(settingsId))
        || (
          settingsId == 'delegation_letter_v2_public'
          && (canWriteFinance() || hasAnyRole(siteRoles()))
        );
      allow delete: if isAdmin();
    }

    match /server_settings/{settingsId} {
      allow read, write: if false;
    }

    // Card-audit results contain executive financial review data. Reads are
    // restricted to CEO/DEV accounts; all mutations are owned by callables.
    match /{collectionId}/{docId} {
      allow read: if isCardExpenseAuditCollection(collectionId)
        && canAccessCardExpenseAudit();
      allow create, update, delete: if false;
    }

    match /{collectionId}/{docId}/{subcollection}/{nestedDocId}/{nested=**} {
      allow read: if isCardExpenseAuditCollection(collectionId)
        && canAccessCardExpenseAudit();
      allow write: if false;
    }

    match /system_configs/{configId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /positions/{positionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /menus/{menuId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /menu_configs/{menuConfigId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /system_logs/{logId} {
      allow create: if isSignedIn();
      allow get, list: if canReadAudit();
      allow update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow create: if isSignedIn();
      allow get, list: if canReadAudit();
      allow update, delete: if false;
    }

    match /database_logs/{logId} {
      allow create: if isSignedIn();
      allow get, list: if canReadAudit();
      allow update, delete: if false;
    }

    match /daily_report_logs/{logId} {
      allow create: if isSignedIn();
      allow get, list: if canReadAudit() || canReadOperations();
      allow update, delete: if false;
    }

    match /material_logs/{logId} {
      allow create: if isSignedIn();
      allow get, list: if canReadAudit() || canReadSupport();
      allow update, delete: if false;
    }

    // Restricted incident records: only audit-capable accounts may read them;
    // mutations are limited to administrators so review ownership is explicit.
    match /incident_cases/{caseId} {
      allow get, list: if canReadAudit();
      allow create: if isAdmin()
        && hasValidIncidentCaseShape(request.resource.data)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid;
      allow update: if isAdmin()
        && hasValidIncidentCaseShape(request.resource.data)
        && request.resource.data.caseNumber == resource.data.caseNumber
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /incident_case_categories/{categoryId} {
      allow get, list: if canReadAudit();
      allow create: if isAdmin() && hasValidIncidentCategoryShape(request.resource.data);
      allow update: if isAdmin()
        && hasValidIncidentCategoryShape(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    match /settlement_alert_states/{stateId} {
      allow get, list: if canReadFinance() || canReadSupport() || canReadOperations() || canReadAudit();
      allow create, update: if canWriteFinance() || canWriteSupport() || isAdmin();
      allow delete: if isAdmin();
    }

    // Bank SMS payloads and provider events are server-owned. Clients can only
    // review normalized candidates, manage global alert settings as an admin,
    // and register their own browser notification device.
    match /bank_sms_ingestions/{ingestionId} {
      allow get, list: if canReadAudit();
      allow create, update, delete: if false;
    }

    match /bank_transaction_candidates/{candidateId} {
      allow get, list: if canReadFinance() || canReadAudit();
      allow create, delete: if false;
      allow update: if canWriteFinance() && isValidBankCandidateReviewUpdate();
    }

    match /bank_notification_settings/{settingsId} {
      allow get, list: if canReadFinance() || canReadAudit();
      allow create, update: if isAdmin() && isValidBankNotificationSettings(request.resource.data);
      allow delete: if false;
    }

    match /notification_devices/{deviceId} {
      allow get: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && isValidOwnNotificationDevice(request.resource.data);
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.token == resource.data.token
        && request.resource.data.platform == resource.data.platform
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'label',
          'browser',
          'userAgent',
          'permission',
          'enabled',
          'updatedAt',
          'lastSeenAt'
        ])
        && isValidOwnNotificationDevice(request.resource.data);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /bank_notification_health/{healthId} {
      allow get, list: if canReadFinance() || canReadAudit();
      allow create, update, delete: if false;
    }

    match /bank_notification_outbox/{outboxId} {
      allow get, list: if canReadAudit();
      allow create, update, delete: if false;
    }

    match /bank_provider_events/{eventId} {
      allow get, list: if canReadAudit();
      allow create, update, delete: if false;
    }

    match /bank_ingestion_replay_nonces/{nonceId} {
      allow read, write: if false;
    }

    // Exact-source idempotency claims are authored only by trusted Cloud
    // Functions. Client access would allow a signed-in user to reserve or
    // redirect a SHA-256 claim and bypass/import-block vehicle expenses.
    match /vehicleExpenseImportIdentities/{identityId} {
      allow read, write: if false;
    }

    // General ERP messages retain their existing signed-in behavior, while
    // server-authored bank alerts are visible only to configured recipients
    // and may only receive the current recipient's read receipt.
    match /erp_messages/{messageId} {
      allow read: if isSignedIn()
        && (
          (isBankSystemMessage(resource.data) && canReadBankSystemMessage(resource.data))
          || (!isBankSystemMessage(resource.data) && canReadRegularErpMessage(resource.data))
        );
      allow create: if isSignedIn()
        && !isBankSystemMessage(request.resource.data)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.type in ['direct', 'broadcast'];
      allow update: if isSignedIn()
        && (
          (isBankSystemMessage(resource.data) && isValidErpMessageReadReceiptUpdate())
          || (
            !isBankSystemMessage(resource.data)
            && !isBankSystemMessage(request.resource.data)
            && request.resource.data.type in ['direct', 'broadcast']
            && (
              isAdmin()
              || ('senderId' in resource.data && resource.data.senderId == request.auth.uid)
              || isValidErpMessageReadReceiptUpdate()
            )
          )
        );
      allow delete: if isSignedIn()
        && !isBankSystemMessage(resource.data)
        && (isAdmin() || ('senderId' in resource.data && resource.data.senderId == request.auth.uid));
    }

    match /support_shared_data/{dataId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canWriteSupport();
    }

    match /materials/{materialId} {
      allow read: if canReadOperations() || isClientPortalAccount() || isRentalPortalAccount();
      allow create, update, delete: if canWriteOperations();
    }

    match /materialInbounds/{transactionId} {
      allow read: if canReadOperations()
        || canReadClientMaterialTransaction()
        || canReadRentalMaterialTransaction();
      allow create, update, delete: if canWriteOperations();
    }

    match /materialOutbounds/{transactionId} {
      allow read: if canReadOperations()
        || canReadClientMaterialTransaction()
        || canReadRentalMaterialTransaction();
      allow create, update, delete: if canWriteOperations();
    }

    match /materialPhotoBatches/{photoBatchId} {
      allow read: if canReadOperations()
        || canReadClientMaterialPhotoBatch()
        || canReadRentalMaterialPhotoBatch();
      allow create, update, delete: if canWriteOperations();
    }

    match /workers/{workerId} {
      allow read: if canReadMasterData() || canReadOwnWorker(workerId);
      allow update: if canWriteMasterData() || isValidOwnWorkerSignatureUpdate(workerId);
      allow create, delete: if canWriteMasterData();
    }

    match /{collectionId}/{docId} {
      allow read: if isMasterDataCollection(collectionId)
        && (
          canReadMasterData()
          || (collectionId == 'companies' && canReadClientCompany(docId))
          || (collectionId == 'companies' && canReadRentalCompany(docId))
          || (collectionId == 'sites' && canReadClientSite())
        );
      allow create, update, delete: if isMasterDataCollection(collectionId) && canWriteMasterData();
    }

    match /{collectionId}/{docId} {
      allow read: if isOperationsCollection(collectionId)
        && (canReadOperations() || (collectionId == 'daily_reports' && canReadClientDailyReport()));
      allow create, update, delete: if isOperationsCollection(collectionId) && canWriteOperations();
    }

    match /recruiting_referrers/{referrerId} {
      allow read: if canRecruitingRead();
      allow create, update: if canRecruitingRegister();
      allow delete: if canRecruitingSettle();
    }

    match /service_worker_referrals/{referralId} {
      allow read: if canRecruitingRead();
      allow create, update: if canRecruitingRegister();
      allow delete: if canRecruitingSettle();
    }

    match /service_referral_daily_lines/{lineId} {
      allow read: if canRecruitingRead();
      allow create, update, delete: if canRecruitingSettle();
    }

    match /service_referral_monthly_settlements/{settlementId} {
      allow read: if canRecruitingRead();
      allow create, update, delete: if canRecruitingSettle();
    }

    match /service_referral_settings/{settingsId} {
      allow read: if canRecruitingRead();
      allow create, update, delete: if canRecruitingSettle();
    }

    match /service_worker_history/{historyId} {
      allow read: if canRecruitingRead();
      allow create, update: if canRecruitingRegister();
      allow delete: if canRecruitingSettle();
    }

    match /service_referral_payments/{paymentId} {
      allow read: if canRecruitingRead();
      allow create, update, delete: if canRecruitingSettle();
    }

    match /service_referral_deposits/{depositId} {
      allow read: if canRecruitingRead();
      allow create, update, delete: if canRecruitingSettle();
    }

    match /service_referral_receivables/{receivableId} {
      allow read: if canRecruitingRead();
      allow create, update, delete: if canRecruitingSettle();
    }

    match /daily_advance_workbook_profiles/{profileId} {
      allow read: if canReadFinance();
      allow create, update, delete: if canWriteFinance();
    }

    match /daily_advance_statement_recruiter_fees/{feeId} {
      allow read: if canReadFinance();
      allow create, update, delete: if canWriteFinance();
    }

    match /monthly_payroll_settlements/{settlementId} {
      allow read: if canReadFinance();
      allow create: if isValidPayrollSettlementCreate();
      allow update: if isValidPayrollSettlementUpdate();
      allow delete: if false;
    }

    match /{collectionId}/{docId} {
      allow read: if isFinanceCollection(collectionId) && collectionId != 'monthly_payroll_settlements'
        && (canReadFinance() || (collectionId == 'progress_claims' && canReadClientProgressClaim()));
      allow create, update, delete: if isFinanceCollection(collectionId)
        && collectionId != 'monthly_payroll_settlements'
        && canWriteFinance();
    }

    match /{collectionId}/{docId} {
      allow read: if isCardStatementImportCollection(collectionId) && canReadCardBillingStatements();
      allow create, update, delete: if false;
    }

    match /cardAssignments/{assignmentId} {
      allow read: if canReadSupport();
      allow create: if canWriteSupport()
        && isCardLifecycleParentTouched(request.resource.data.cardId)
        && isCardLifecycleParentActiveAfter(request.resource.data.cardId);
      allow update: if canWriteSupport()
        && request.resource.data.cardId == resource.data.cardId
        && isCardLifecycleParentTouched(request.resource.data.cardId)
        && (
          !isOpenCardLink(request.resource.data)
          || isCardLifecycleParentActiveAfter(request.resource.data.cardId)
        );
      allow delete: if canWriteSupport()
        && (
          isCardLifecycleParentTouched(resource.data.cardId)
          || isCardLifecycleParentMissing(resource.data.cardId)
        );
    }

    match /cards/{cardId} {
      allow read: if canReadSupport();
      allow create: if canWriteSupport()
        && request.resource.data.status == 'AVAILABLE'
        && request.resource.data.get('createdAt', null) == request.time
        && request.resource.data.get('updatedAt', null) == request.time
        && hasEmptyCardOperationalSnapshot(request.resource.data);
      allow update: if canWriteSupport() && isValidCardStatusUpdate(cardId);
      allow delete: if false;
    }

    match /cardBillingTargets/{targetId} {
      allow read: if canReadSupport();
      allow create: if canWriteSupport()
        && isCardLifecycleParentTouched(request.resource.data.cardId)
        && isCardLifecycleParentActiveAfter(request.resource.data.cardId);
      allow update: if canWriteSupport()
        && request.resource.data.cardId == resource.data.cardId
        && isCardLifecycleParentTouched(request.resource.data.cardId)
        && (
          !isOpenCardLink(request.resource.data)
          || isCardLifecycleParentActiveAfter(request.resource.data.cardId)
        );
      allow delete: if canWriteSupport()
        && (
          isCardLifecycleParentTouched(resource.data.cardId)
          || isCardLifecycleParentMissing(resource.data.cardId)
        );
    }

    match /{collectionId}/{docId} {
      allow read: if isSupportCollection(collectionId) && canReadSupport();
      allow create, update, delete: if isSupportCollection(collectionId) && canWriteSupport();
    }

    match /welfare_game_plays/{playId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow get, list: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    // Construction plans retain a revision trail. Issued/closed records are
    // immutable; corrections must be authored as a new draft revision.
    match /constructionPlans/{planId} {
      allow get: if canReadConstructionPlanData(resource.data);
      // Participant portfolio queries run through the scoped callable. Only
      // central roles may issue an unbounded browser collection query.
      allow list: if hasConstructionPlanCentralAccess();
      // Draft identity, document number and revision are allocated by the
      // trusted series transaction. Browser clients may edit an existing
      // draft while holding its lock, but cannot create a parallel lineage.
      allow create: if false;
      allow update: if canWriteConstructionPlanData(resource.data) && isValidConstructionPlanUpdate();
      allow delete: if false;
    }

    // Review bodies and replies can be narrower than the parent plan ACL
    // (`central_only` / reviewer visibility). Browser reads would make those
    // policies impossible to enforce consistently, so all collaboration data
    // is projected by the trusted callables.
    match /constructionPlans/{planId}/comments/{commentId}/{nested=**} {
      allow read, write: if false;
    }

    match /constructionPlans/{planId}/{subcollection}/{nestedDocId}/{nested=**} {
      // Review comment visibility is stricter than plan participation and is
      // filtered by the trusted callable. Snapshot/workflow metadata remains
      // readable to plan participants through the parent ACL.
      allow read: if subcollection != 'comments' && canReadConstructionPlanById(planId);
      allow write: if false;
    }

    match /constructionPlanSeries/{seriesId} {
      allow get, list: if hasConstructionPlanCentralAccess();
      allow create, update, delete: if false;
    }

    match /constructionPlanSeries/{seriesId}/{subcollection}/{nestedDocId}/{nested=**} {
      // Idempotency claims and allocation internals are server-only. The
      // public lineage view is the top-level series plus plan documents.
      allow read, write: if false;
    }

    match /constructionPlanMutationKeys/{claimId} {
      // Contains hashed idempotency claims and request fingerprints. Only the
      // trusted callable pipeline may inspect or mutate this collection.
      allow read, write: if false;
    }

    match /constructionPlanMutationKeys/{claimId}/{subcollection}/{nestedDocId}/{nested=**} {
      allow read, write: if false;
    }

    match /constructionPlanDrawingReuseJobs/{jobId} {
      // Contains immutable Storage paths/generations/SHA values, opaque
      // idempotency ownership and cleanup state. Visibility and mutations are
      // projected exclusively by trusted drawing-reuse callables.
      allow read, write: if false;
    }

    match /constructionPlanDrawingReuseJobs/{jobId}/{subcollection}/{nestedDocId}/{nested=**} {
      allow read, write: if false;
    }

    // Unlock requests, lifecycle idempotency claims and PDF download receipts
    // are created and projected only by trusted callables. They contain exact
    // concurrency bindings and must never be forged or enumerated by clients.
    match /constructionPlanLockRequests/{requestId} {
      allow read, write: if false;
    }

    match /constructionPlanLifecycleMutationReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /constructionPlanPdfDownloadReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /constructionPlanPdfDownloadGrants/{grantId} {
      allow read, write: if false;
    }

    match /welfare_game_daily_usage/{usageId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /{collectionId}/{docId} {
      allow read: if isWelfareCollection(collectionId) && isAdmin();
      allow create, update, delete: if isWelfareCollection(collectionId) && isAdmin();
    }

    match /{collectionId}/{docId}/{subcollection}/{nestedDocId}/{nested=**} {
      allow read: if isMasterDataCollection(collectionId) && canReadMasterData();
      allow create, update, delete: if isMasterDataCollection(collectionId) && canWriteMasterData();

      allow read: if isOperationsCollection(collectionId) && canReadOperations();
      allow create, update, delete: if isOperationsCollection(collectionId) && canWriteOperations();

      allow read: if isFinanceCollection(collectionId)
        && collectionId != 'monthly_payroll_settlements'
        && canReadFinance();
      allow create, update, delete: if isFinanceCollection(collectionId)
        && collectionId != 'monthly_payroll_settlements'
        && canWriteFinance();

      allow read: if isCardStatementImportCollection(collectionId) && canReadCardBillingStatements();
      allow create, update, delete: if false;

      allow read: if isSupportCollection(collectionId) && canReadSupport();
      allow create, update, delete: if isSupportCollection(collectionId) && canWriteSupport();
    }

    match /{collectionId}/{docId} {
      allow read, write: if isSignedIn() && !isLockedCollection(collectionId);
    }

    match /{collectionId}/{docId}/{subcollection}/{nestedDocId}/{nested=**} {
      allow read, write: if isSignedIn() && !isLockedCollection(collectionId);
    }
  }
}
