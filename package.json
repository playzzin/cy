  "scripts": {
    "start": "node scripts/react-scripts-start.js",
    "start:checked": "node scripts/react-scripts-start.js --typecheck",
    "build": "node --max-old-space-size=8192 scripts/react-scripts-build.js",
    "postbuild": "node scripts/release-manifest.cjs",
    "release:verify": "node scripts/check-release.cjs",
    "release:deploy": "node scripts/deploy-verified.cjs",
    "deploy:hosting": "node scripts/deploy-verified.cjs",
    "deploy:functions": "node scripts/deploy-selected.cjs functions",
    "deploy:rules": "node scripts/deploy-selected.cjs firestore:rules",
    "deploy:indexes": "node scripts/deploy-selected.cjs firestore:indexes",
    "deploy:storage": "node scripts/deploy-selected.cjs storage",
    "verify:hosting-build": "node scripts/verify-hosting-build.js",
    "verify:project": "node scripts/verify-project-health.js",
    "verify:hosting": "node scripts/verify-project-health.js --scope=hosting",
    "verify:functions": "node scripts/verify-project-health.js --scope=functions",
    "test:release-tools": "node --test scripts/release-manifest.test.cjs scripts/staging-isolation.test.cjs scripts/browser-env-security.test.cjs scripts/build-performance.test.cjs scripts/typecheck.test.cjs scripts/react-scripts-test.test.cjs scripts/test-verification-cache.test.cjs scripts/verify-project-health.test.cjs scripts/deploy-selected.test.cjs scripts/hosting-build-cache.test.cjs scripts/check-release.test.cjs scripts/clean-build-artifacts.test.cjs scripts/quality-workflow.test.cjs",
    "clean:generated": "node scripts/clean-build-artifacts.cjs",
    "typecheck": "node scripts/typecheck.cjs",
    "test:ci": "node scripts/react-scripts-test.cjs",
    "test:card-statement-import": "npm run test:ci -- --runTestsByPath src/components/card/CardStatementImportModal.test.tsx src/components/card/CardStatementImportHistoryModal.test.tsx src/utils/cardStatementDeduplication.test.ts",
    "functions:build": "npm --prefix functions run build",
    "test:bank-rules": "node scripts/run-bank-rules-test.mjs",
    "test:vehicle-import-rules": "node scripts/run-vehicle-import-rules-test.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:functions": "npm --prefix functions audit --omit=dev --audit-level=high",
    "audit:all": "npm run audit:prod && npm run audit:functions",
    "todo:codex-bridge": "node scripts/todo-codex-bridge.mjs",
    "todo:codex-automation": "node scripts/todo-codex-bridge.mjs --watch",
    "todo:codex-run": "node scripts/todo-codex-worker.mjs",
    "todo:codex-dry-run": "node scripts/todo-codex-worker.mjs --dry-run",
    "todo:codex-auto": "node scripts/todo-codex-worker.mjs --watch",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "build:staging": "node scripts/build-staging.cjs",
    "staging:config": "node scripts/staging-project.cjs config",
    "staging:deploy": "node scripts/deploy-staging.cjs",
    "test:functions": "node scripts/run-functions-tests.cjs",
    "lint:improvements": "eslint src/features/team-registration src/services/geminiGatewayClient.ts src/services/geminiUsageFetch.ts src/pages/taxinvoice/utils/taxInvoiceLedgerExport.ts src/pages/taxinvoice/WorkbookLedgerModel.ts src/pages/payroll/MonthlyWageModel.ts src/pages/payroll/MonthlyWageStyles.ts src/pages/payroll/SupportClientSiteModel.ts src/pages/payroll/SupportClientStatementPanels.tsx src/pages/taxinvoice/TaxInvoiceLedgerPage.tsx src/pages/taxinvoice/printing src/pages/payroll/components/KBTransferPreview.tsx src/pages/payroll/utils/kbTransferWorkbook.ts src/pages/payroll/utils/kbTransferExport.ts --ext .ts,.tsx --max-warnings=0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": "off",
      "react-hooks/exhaustive-deps": "off"
    },
    "overrides": [
      {
        "files": [
          "src/features/team-registration/**/*.{ts,tsx}",
          "src/services/geminiGatewayClient.ts",
          "src/services/geminiUsageFetch.ts",
          "src/pages/taxinvoice/utils/taxInvoiceLedgerExport.ts",
          "src/pages/taxinvoice/WorkbookLedgerModel.ts",
          "src/pages/payroll/MonthlyWageModel.ts",
          "src/pages/payroll/MonthlyWageStyles.ts",
          "src/pages/payroll/SupportClientSiteModel.ts",
          "src/pages/payroll/SupportClientStatementPanels.tsx",
          "src/pages/taxinvoice/TaxInvoiceLedgerPage.tsx",
          "src/pages/taxinvoice/printing/**/*.{ts,tsx}",
          "src/pages/payroll/components/KBTransferPreview.tsx",
          "src/pages/payroll/utils/kbTransferWorkbook.ts",
          "src/pages/payroll/utils/kbTransferExport.ts"
        ],
        "rules": {
          "@typescript-eslint/no-unused-vars": "error",
          "react-hooks/exhaustive-deps": "error"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/lodash": "^4.17.24",
    "node-fetch": "^3.3.2"
  },
  "overrides": {
    "@material-tailwind/react": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
